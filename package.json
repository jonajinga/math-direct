{
  "name": "teach-direct",
  "version": "2.0.0",
  "description": "Free scripted Direct Instruction lessons a parent teaches from a phone: math for Pre-K through First Grade, with reading to come.",
  "scripts": {
    "start": "npx @11ty/eleventy --serve --port=8080",
    "dev": "npx @11ty/eleventy --serve --port=8080",
    "build": "npx @11ty/eleventy",
    "check": "node scripts/check-curriculum.js",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:fit": "node scripts/check-fit.mjs",
    "check:fit:all": "node scripts/check-fit.mjs --all",
    "check:session": "node scripts/check-session.mjs",
    "check:program": "node scripts/check-program.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:keys": "node scripts/check-keyboard.mjs",
    "check:import": "node scripts/check-import.mjs",
    "check:all": "npm run check && npm run clean && npm run build && npm run check:pwa && npm run check:copy",
    "check:browser": "npm run check:fit && npm run check:session && npm run check:program && npm run check:a11y && npm run check:keys && npm run check:import"
  },
  "keywords": [
    "math",
    "reading",
    "phonics",
    "education",
    "addition",
    "subtraction",
    "direct-instruction",
    "open-source"
  ],
  "author": "Pikes Peak Web Designs",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@sardine/eleventy-plugin-tinyhtml": "^0.2.0",
    "axe-core": "^4.10.3"
  }
}
