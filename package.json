{
  "name": "math-direct",
  "version": "1.0.0",
  "description": "Free scripted Direct Instruction math lessons for Pre-K, Kindergarten, and First Grade.",
  "scripts": {
    "start": "npx @11ty/eleventy --serve --port=8080",
    "dev": "npx @11ty/eleventy --serve --port=8080",
    "build": "npx @11ty/eleventy",
    "check": "node scripts/check-curriculum.js",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:fit": "node scripts/check-fit.mjs",
    "check:fit:all": "node scripts/check-fit.mjs --all",
    "check:session": "node scripts/check-session.mjs",
    "check:all": "npm run check && npm run clean && npm run build && npm run check:pwa && npm run check:copy"
  },
  "keywords": [
    "math",
    "education",
    "addition",
    "subtraction",
    "direct-instruction",
    "open-source"
  ],
  "author": "Pikes Peak Web Designs",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@sardine/eleventy-plugin-tinyhtml": "^0.2.0"
  }
}
