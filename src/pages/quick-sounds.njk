---
layout: layouts/runner.njk
title: Quick sounds
description: A short, parent-led review of the sounds the child has been taught, with missed sounds coming up first.
permalink: /quick-sounds/
exitUrl: /practice/
---
<div class="runner-start" id="sounds-start">
  <article class="finish">
    <p class="eyebrow">Sound review</p>
    <h1 class="finish__title">Quick sounds</h1>
    <p class="finish__lead">Twelve sounds, drawn from the sounds the selected child has been taught. Sounds the child has missed recently come up first, then sounds not yet tried, then a few that are already firm. Hold the dot, let the child say the sound, and mark Firm or Error. A sound counts as firm after three right answers in a row, and automatic when each took under two seconds.</p>
    <p class="finish__lead" id="sounds-who"></p>
    <div class="btn-row btn-row--stack">
      {% for level in program.summary %}{% if level.sounds.length %}
      <button type="button" class="btn btn--primary btn--block" data-sounds="{{ level.id }}">{{ level.name }} sounds</button>
      {% endif %}{% endfor %}
    </div>
    <ul class="finish__links"><li><a href="/records/">See the sound chart on the Records screen</a></li><li><a href="/practice/">All practice</a></li></ul>
  </article>
</div>
<script id="sounds-data" type="application/json">{"levels":{{ program.summary | dump | safe }},"items":{{ program.soundItems | dump | safe }}}</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  var start = document.getElementById("sounds-start");
  var data = JSON.parse(document.getElementById("sounds-data").textContent);
  // Twelve sounds, missed ones first, run by the lesson engine as an ordered practice set.
  function go(levelId) {
    var P = window.mathProgress;
    var lv = data.levels.filter(function (l) { return l.id === levelId; })[0];
    var next = P ? P.nextLesson(levelId, lv.lessons) : lv.lessons;
    var all = data.items[levelId];
    var pool = all.filter(function (s) { return s.lesson < next; });
    if (pool.length < 6) pool = all.filter(function (s) { return s.lesson <= Math.max(next, all[all.length - 1].lesson); }).slice(-6);
    var profile = P ? P.getActiveProfile() : null;
    // Missed in the last five marks first, then not yet tried, then the rest.
    var rank = { "new": 1, learning: 2, firm: 3, automatic: 4 };
    pool.forEach(function (s) {
      var rec = profile && profile.sounds && profile.sounds[s.sound];
      s._s = (P && P.missedRecently(rec) ? 0 : rank[P ? P.soundStatus(rec) : "new"]) + Math.random() * 0.9;
    });
    pool.sort(function (a, b) { return a._s - b._s; });
    var chosen = pool.slice(0, 12).map(function (s) { var c = {}; for (var k in s) c[k] = s[k]; c.lesson = 0; return c; });
    var runner = { mode: "practice", subject: "reading", ordered: true, exitUrl: "/quick-sounds/", count: chosen.length, set: { title: lv.name + " sounds", level: levelId, levelName: lv.name, items: chosen } };
    start.hidden = true;
    window.mdRunner.start(runner, { again: function () { go(levelId); } });
    var more = document.getElementById("btn-more");
    if (more) more.focus();
  }
  var btns = document.querySelectorAll("[data-sounds]");
  for (var i = 0; i < btns.length; i++) btns[i].addEventListener("click", function () { go(this.getAttribute("data-sounds")); });
  var who = document.getElementById("sounds-who");
  if (who && window.mathProgress && window.mathProgress.getActiveProfile()) who.textContent = "Child: " + window.mathProgress.getActiveProfile().name + ".";
});
</script>
