---
layout: layouts/app.njk
title: Lessons
description: Scripted lessons by subject and level. Choose a level, or let the placement test choose.
permalink: /lessons/
bodyClass: page-lessons
---
<header class="screen__head">
  <h1 class="screen__title">Lessons</h1>
  <p class="screen__lead">Choose the level that fits the child, or let the placement test choose. Teach the lessons in order, one a day.</p>
</header>

<div data-child-picker></div>

{% for s in program.subjects %}
{% if program.subjects.length > 1 %}<h2 class="section-title" id="{{ s.id }}">{{ s.name }}</h2>{% endif %}
<ul class="rows">
  {% for level in program.levels %}{% if level.subject == s.id %}
  <li>
    <a class="row level-row" href="{{ level.url }}" data-level-actions data-level="{{ level.id }}" data-total="{{ level.lessons }}" data-slug="{{ level.slug }}" data-tests='{{ level.tests | dump }}'>
      <span class="row__main">
        <span class="row__title level-row__name">{{ level.name }}{% if level.optional %} <span class="status status--plain">Optional</span>{% endif %}</span>
        <span class="row__sub">{{ level.lessons }} lessons · {{ level.minutes }} minutes each · {% if level.optional %}{{ level.age }}{% else %}for a child of {{ level.age }}{% endif %}</span>
        <span class="pbar" aria-hidden="true"><span class="pbar__fill" data-progress></span></span>
        <span class="row__sub" data-progress-label>Not started</span>
      </span>
      {% include "partials/icons/chevron-right.njk" %}
    </a>
  </li>
  {% endif %}{% endfor %}
  <li>
    <a class="row" href="{{ s.placementUrl }}">
      <span class="row__main"><span class="row__title">Placement test{% if program.subjects.length > 1 %}: {{ s.name | lower }}{% endif %}</span><span class="row__sub">Ten to twenty minutes. It names the lesson to begin with.</span></span>
      {% include "partials/icons/chevron-right.njk" %}
    </a>
  </li>
</ul>
{% endfor %}

<script src="/assets/js/progress.js?v={{ build.version }}"></script>
<script src="/assets/js/lessons-index.js?v={{ build.version }}" defer></script>
