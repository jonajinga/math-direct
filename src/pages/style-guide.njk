        <div class="curriculum-stat"><span class="curriculum-stat__number">{{ program.levels.length }}</span><span class="curriculum-stat__label">Levels</span></div>
        <div class="curriculum-stat"><span class="curriculum-stat__number">{{ program.tests.length }}</span><span class="curriculum-stat__label">Mastery tests</span></div>
        <div class="curriculum-stat"><span class="curriculum-stat__number">{{ program.practice.length }}</span><span class="curriculum-stat__label">Practice sets</span></div>
      </div>
    </div>

  </div>
</div>
