---
pagination:
  data: program.levels
  size: 1
  addAllPagesToCollections: true
  alias: level
permalink: "{{ level.url }}"
layout: layouts/base.njk
bodyClass: page-level
eleventyComputed:
  title: "{{ level.name }}"
  description: "{{ level.description }}"
---
<div class="level-page">
  <div class="level-page__inner">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/lessons/">Lessons</a> <span aria-hidden="true">/</span> {{ level.name }}</nav>
    <header class="level-head">
      <div>
        <h1 class="level-head__title">{{ level.name }}{% if level.optional %} <span class="level-head__tag">Optional</span>{% endif %}</h1>
        <p class="level-head__facts">{{ level.lessons }} lessons &middot; {{ level.minutes }} minutes each &middot; for children {{ level.age }}</p>
      </div>
      <div class="level-head__student" data-student-select></div>
    </header>
    <p class="level-lead">{{ level.description }}</p>

    <div class="level-actions" data-level-actions data-level="{{ level.id }}" data-total="{{ level.lessons }}" data-slug="{{ level.slug }}" data-tests='{{ level.tests | dump }}'>
      <a class="btn btn--cta" href="{{ level.firstLesson }}" data-continue>Start Lesson 1</a>
      <a class="btn btn--outline-dark" href="/placement/">Placement test</a>
      <a class="btn btn--outline-dark" href="/curriculum/#{{ level.id }}">Scope and sequence</a>
      <a class="btn btn--outline-dark" href="/practice/#{{ level.id }}">Practice</a>
    </div>

    <div class="level-grid-info">
      <section class="level-box">
        <h2>What the child will learn</h2>
        <p>{{ level.endsWith }}</p>
      </section>
      <section class="level-box">
        <h2>What you need</h2>
        <ul>
          <li>A phone, tablet, or computer for the lesson screen</li>
          {% for m in level.materials %}<li>{{ m }}</li>{% endfor %}
        </ul>
        <p class="level-box__note">Printable number cards, dot cards, and ten-frames are on the <a href="/materials/">materials page</a>.</p>
      </section>
    </div>

    <h2 class="level-section-title">Lessons</h2>
    <p class="level-section-note">Each lesson begins with a short warm-up, teaches something new, and reviews earlier skills. A mastery test follows every tenth lesson. A check mark shows a lesson the selected child has finished; a lesson to repeat is marked in amber.</p>
    {% for lesson in level.lessonList %}
    {% if loop.index0 % 10 == 0 %}<div class="lesson-block"><h3 class="lesson-block__title">Lessons {{ lesson.number }} to {{ [lesson.number + 9, level.lessons] | min }}</h3><div class="lesson-grid2">{% endif %}
      <a href="{{ lesson.url }}" class="lcard" data-lesson-id="{{ lesson.id }}">
        <span class="lcard__n">{{ lesson.number }}</span>
        <span class="lcard__new">{% if lesson.newUnits.length %}{{ lesson.newUnits[0].label }}{% if lesson.newUnits.length > 1 %} and more{% endif %}{% else %}Review{% endif %}</span>
        <span class="lcard__mark" aria-hidden="true"></span>
      </a>
      {% if lesson.testAfter %}
      <a href="{{ lesson.testAfter.url }}" class="lcard lcard--test" data-test-id="{{ level.id }}-test-{{ ((lesson.number / 10) | round(0, 'floor')) | pad }}">
        <span class="lcard__n">Test</span>
        <span class="lcard__new">{{ lesson.testAfter.title }}</span>
        <span class="lcard__mark" aria-hidden="true"></span>
      </a>
      {% endif %}
    {% if loop.index0 % 10 == 9 or loop.last %}</div></div>{% endif %}
    {% endfor %}

    <h2 class="level-section-title">Skill tracks</h2>
    <p class="level-section-note">A track is one skill taught across many lessons. Several tracks run side by side, so each lesson practices a little of each.</p>
    <div class="track-list">
      {% for t in level.tracks %}
      <details class="track">
        <summary><span class="track__name">{{ t.name }}</span> <span class="track__std">{{ t.standard }}</span></summary>
        <p>{{ t.summary }}</p>
        <ol class="track__units">
          {% for u in t.units %}<li><a href="/{{ level.slug }}/lesson-{{ u.lesson | pad(3) }}/">Lesson {{ u.lesson }}</a>: {{ u.label }}</li>{% endfor %}
        </ol>
      </details>
      {% endfor %}
    </div>
  </div>
</div>
<script src="/assets/js/progress.js"></script>
<script src="/assets/js/lessons-index.js" defer></script>
