---
layout: layouts/app.njk
title: Practice
description: Extra practice for any skill, drawn only from what the child has been taught, and a quick review of the facts.
permalink: /practice/
bodyClass: page-practice
---
<header class="screen__head">
  <h1 class="screen__title">Practice</h1>
  <p class="screen__lead">Ten items from one skill, drawn only from lessons the child has finished. You read, the child answers, you mark.</p>
</header>

<div data-child-picker></div>

<ul class="rows">
  <li>
    <a class="row" href="/facts/">
      <span class="row__main"><span class="row__title">Quick facts</span><span class="row__sub">Twelve addition and subtraction facts. Missed facts come up first.</span></span>
      {% include "partials/icons/chevron-right.njk" %}
    </a>
  </li>
</ul>

{% for level in program.levels %}
<details class="fold practice-level" id="{{ level.id }}" data-practice-level="{{ level.id }}">
  <summary>{{ level.name }}</summary>
  <div class="fold__body">
    <ul class="rows">
      {% for set in program.practice %}{% if set.level == level.id %}
      <li><a class="row" href="{{ set.url }}"><span class="row__main"><span class="row__title">{{ set.title }}</span><span class="row__sub">From lesson {{ set.startsAt }}. {{ set.summary }}</span></span>{% include "partials/icons/chevron-right.njk" %}</a></li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</details>
{% endfor %}

<script src="/assets/js/progress.js?v={{ build.version }}"></script>
<script>
(function () {
  var P = window.mathProgress;
  var level = P && P.currentLevel && P.currentLevel();
  var open = document.querySelector(level ? '[data-practice-level="' + level + '"]' : "[data-practice-level]");
  if (open) open.open = true;
})();
</script>
